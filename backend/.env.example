# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace_with_a_secure_random_key_for_session_management
JWT_SECRET_KEY=replace_with_a_secure_random_key_for_jwt_tokens

# Database Connection
# Format: mysql+pymysql://user:password@host:port/database_name
DATABASE_URL=mysql+pymysql://root:@localhost/cloud_optimizer

# Server Configuration
PORT=5000
